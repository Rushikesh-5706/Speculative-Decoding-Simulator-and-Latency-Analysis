# Hugging Face token — only required if switching to a gated model. gpt2 and gpt2-large are public.
HF_TOKEN=your_huggingface_token_here

# Hugging Face model cache location (keeps model downloads out of the repo)
HF_CACHE_DIR=./.hf_cache

# Directory where sweep_metrics.csv and crossover_report.json are written
RESULTS_DIR=./results

# Set to false to suppress tokenizers fork warning (safe to leave as false for single-process use)
TOKENIZERS_PARALLELISM=false
