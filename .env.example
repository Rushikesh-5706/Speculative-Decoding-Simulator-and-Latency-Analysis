# Hugging Face token — only required if switching to a gated model. gpt2 and gpt2-large are public.
HF_TOKEN=your_huggingface_token_here

# Directory containing the prepared prompt dataset
DATA_DIR=./data

# Directory where sweep_metrics.csv and crossover_report.json are written
RESULTS_DIR=./results

# Hugging Face cache location (keeps model downloads out of the repo)
TRANSFORMERS_CACHE=./.hf_cache
